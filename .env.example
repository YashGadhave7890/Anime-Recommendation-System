# =============================================================================
# ANIMORA — Production & Development Environment Template
# Copy this file to .env and adjust variables for your target deployment.
# =============================================================================

# --- Backend Server Configuration ---
PROJECT_NAME="ANIMORA — Anime Recommendation Engine API"
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000

# --- Database Configuration ---
# Local SQLite default:
DATABASE_URL=sqlite:///data/animora.db

# Render Persistent Disk configuration (mount path: /var/data):
# DATABASE_URL=sqlite:////var/data/animora.db

# Production PostgreSQL alternative:
# DATABASE_URL=postgresql://user:password@host:5432/animoradb

# --- Frontend CORS Allowed Origins ---
# Comma-separated list of allowed origins (e.g. local dev + production Vercel domain)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-animora-app.vercel.app

# --- Frontend Configuration (for frontend/.env) ---
# VITE_API_BASE_URL=https://your-animora-backend.onrender.com
